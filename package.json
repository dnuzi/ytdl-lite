{
  "name": "ytdl-lite",
  "version": "1.0.1",
  "description": "Zero-dependency YouTube downloader & search — MP3/MP4 links, quality selection, file saving, CLI. Works with CommonJS and ESM.",
  "main": "./index.js",
  "module": "./index.mjs",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": { "ytdl": "./bin/cli.js" },
  "files": ["index.js", "index.mjs", "lib", "bin", "types", "README.md", "CHANGELOG.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "sideEffects": false,
  "scripts": {
    "test": "node --test test/",
    "test:live": "node test.js"
  },
  "keywords": ["youtube", "playlist", "video-info", "downloader", "search", "ytmp3", "ytmp4", "mp3", "mp4", "scraper", "cli", "esm", "commonjs", "danuzz"],
  "author": "@DanuZz",
  "license": "MIT",
  "homepage": "https://www.dnuz.top",
  "repository": { "type": "git", "url": "https://github.com/dnuzi/ytdl-lite.git" },
  "bugs": { "url": "https://github.com/dnuzi/ytdl-lite/issues" },
  "dependencies": {}
}
